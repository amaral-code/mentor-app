{
  "name": "midnight-mentor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mentor/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "test": "turbo run test && npm run test:raiz",
    "test:raiz": "vitest run --config vitest.raiz.config.mjs",
    "preview": "npm run preview --workspace @mentor/web",
    "check:secrets": "node scripts/verificar-segredos.mjs",
    "deploy:worker:staging": "npx --yes wrangler@4 deploy --env staging",
    "deploy:worker:prod": "npx --yes wrangler@4 deploy --env production",
    "db:migrate": "bash scripts/migrar.sh"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/node": "^24.13.2",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "turbo": "^2.11.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
