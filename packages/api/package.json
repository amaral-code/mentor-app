{
  "name": "@mentor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Acesso a dados do Midnight Mentor: cliente Supabase, repositórios e serviços que falam com o back-end. Compartilhado entre web e mobile.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "gen:types": "node scripts/gerar-tipos-banco.mjs",
    "check:types": "node scripts/gerar-tipos-banco.mjs --check"
  },
  "dependencies": {
    "@mentor/core": "*",
    "@supabase/supabase-js": "^2.110.8"
  }
}
