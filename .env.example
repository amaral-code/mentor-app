# ==========================================================================
# TEMPLATE DE VARIAVEIS - sem segredos, so placeholders.
# ==========================================================================
#
# LEIA ISTO PRIMEIRO
# --------------------------------------------------------------------------
# Este arquivo NAO e mais necessario para publicar o app. Em producao
# (Vercel), tudo abaixo mora em:
#
#     Vercel -> Settings -> Environment Variables
#
# O app le essas variaveis EM TEMPO DE EXECUCAO pela rota /api/config, e
# as chaves de servidor nunca saem de dentro de /api/*. Trocar uma
# variavel no painel vale no proximo carregamento da pagina - sem rebuild.
#
# Este .env local existe so para conforto de quem desenvolve: `npm run dev`
# sobe o MESMO back-end (/api) que roda na Vercel e le as variaveis daqui.
# Voce tambem pode simplesmente exportar as variaveis no terminal.
#
#
# AS DUAS FAMILIAS DE VARIAVEL (a distincao que importa)
# --------------------------------------------------------------------------
# SEM prefixo VITE_  -> lida SO no servidor (/api/*). Nunca entra no
#                       JavaScript que o navegador baixa. Todo SEGREDO
#                       pertence aqui.
#
# COM prefixo VITE_  -> gravada dentro do bundle durante o build. Qualquer
#                       visitante consegue ler com F12. Serve apenas para
#                       valor publico, e mesmo assim so como RESERVA: a
#                       versao sem prefixo, lida em runtime, sempre vence.
#
# Regra pratica: se vazar te causa prejuizo, NAO pode ter VITE_.
#
# ==========================================================================


# ==========================================================================
# 1. BANCO DE DADOS (obrigatorio)
# ==========================================================================

# URL RAIZ do projeto Supabase, sem /rest/v1/
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave anon/publishable (Settings -> API). Publica por desenho: quem
# protege os dados e a RLS. NUNCA use a service_role aqui.
SUPABASE_ANON_KEY=


# ==========================================================================
# 2. IA (obrigatorio para chat, quiz, redacao e OCR)
# ==========================================================================

# Provedor: "deepseek" (padrao) ou "gemini".
AI_PROVIDER=deepseek

# Modelo efetivo. Para DeepSeek-V4-Flash, use exatamente:
AI_MODEL=deepseek-v4-flash

# SEGREDO. Fica so no servidor (/api/*). O navegador jamais a recebe.
DEEPSEEK_API_KEY=

# SEGREDO. Usada pelo back-end para o que exige VISAO: correcao de
# redacao por foto e OCR do caderno. Independe do AI_PROVIDER do chat.
GEMINI_API_KEY=

# Modelo de visao usado nessas rotas.
AI_VISION_MODEL=gemini-1.5-flash


# ==========================================================================
# 3. OPCIONAIS (cada um liga um recurso)
# ==========================================================================

# SEGREDO. Vozes neurais das Pilulas de Audio. Sem ela, o app usa a voz
# do proprio aparelho - funciona, so com qualidade menor.
GOOGLE_TTS_KEY=

# SEGREDO. Ignora a RLS. Usada so na importacao de turmas, que cria
# contas. Nunca exponha ao navegador.
SUPABASE_SERVICE_KEY=

# SEGREDO. Envio dos emails de boas-vindas da importacao de turmas.
RESEND_API_KEY=
EMAIL_REMETENTE=

# SEGREDO. Pagamento das consultas. Sem ele, o fluxo roda em modo simulado.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Endereco publico do app (links dos emails). Ex.: https://seu-app.vercel.app
PUBLIC_APP_URL=

# Webhook N8N do painel educacional (reserva do envio de turmas).
N8N_WEBHOOK_URL=


# ==========================================================================
# 4. SO PARA BACK-END EXTERNO (deixe vazio na Vercel)
# ==========================================================================
#
# Por padrao o back-end e /api no proprio dominio. Preencha AI_BASE_URL
# apenas para apontar de volta a um Cloudflare Worker publicado.
# AI_BASE_URL=https://seu-worker.workers.dev
#
# Senha das rotas do worker. Desnecessaria com back-end na mesma origem,
# porque nao existe origem terceira para barrar.
# AI_PROXY_TOKEN=
#
# Origem autorizada no worker externo. Na mesma origem, nao se aplica.
# ALLOWED_ORIGIN=https://seu-app.vercel.app


# ==========================================================================
# 5. RESERVA DE BUILD (so para front estatico, sem /api)
# ==========================================================================
#
# Publicando em host SEM funcoes serverless, /api/config nao existe e o
# app cai nestas, congeladas no bundle durante o build. Na Vercel, ignore.
# So valor publico entra aqui - jamais um segredo da secao 2 ou 3.
#
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
#
# Chave PESSOAL do usuario para o modo Gemini direto, sem back-end. Vai
# para o bundle: prefira restringir por referer no Google Cloud, ou deixe
# o proprio usuario digitar a dele em Perfil > IA (vence esta).
# VITE_GEMINI_API_KEY=
