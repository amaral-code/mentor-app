# Copie para .env e preencha. O .env real e gitignored (nunca commite chaves).
#
# Apos criar/alterar o .env, REINICIE o dev server (o Vite le o .env so na
# inicializacao).

# URL RAIZ do projeto Supabase, sem /rest/v1/
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave anon/publishable (Settings -> API). Publica por design (vai ao bundle);
# quem protege os dados e a RLS. NUNCA use a service_role em variavel VITE_*.
VITE_SUPABASE_ANON_KEY=

# Provedor de IA: "gemini" (padrao) ou "deepseek".
VITE_AI_PROVIDER=deepseek

# Modelo efetivo. Para DeepSeek-V4-Flash, use exatamente:
VITE_AI_MODEL=deepseek-v4-flash

# Base da API DeepSeek (padrao oficial, compativel OpenAI).
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek e 100% BACK-END: o navegador nunca chama a API direto.
#   DEEPSEEK_API_KEY  chave LADO SERVIDOR (SEM prefixo VITE_: nunca vai ao
#                     bundle). Usada pelo proxy local do Vite dev. Cole a
#                     chave real somente no seu .env local, jamais aqui.
DEEPSEEK_API_KEY=

# Worker publicado = back-end de producao (server/worker.js + secret
# DEEPSEEK_API_KEY no provedor). Sem isso, o app usa o proxy local de dev.
# VITE_AI_BASE_URL=https://seu-worker.workers.dev
# VITE_AI_PROXY_TOKEN=
